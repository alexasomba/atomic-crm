{
  "name": "atomic-crm-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env index.ts",
    "start": "tsx index.ts",
    "dev:mcp": "tsx watch --env-file-if-exists=.env mcp/contract-analyzer.ts",
    "start:mcp": "tsx mcp/contract-analyzer.ts",
    "postinstall": "rm -rf node_modules/@copilotkit/runtime/node_modules/@copilotkit/license-verifier node_modules/@copilotkit/shared/node_modules/@copilotkit/license-verifier 2>/dev/null; true"
  },
  "dependencies": {
    "@ag-ui/mcp-apps-middleware": "catalog:",
    "@copilotkit/license-verifier": "catalog:",
    "@copilotkit/runtime": "catalog:",
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "hono": "catalog:",
    "openai": "catalog:",
    "papaparse": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/papaparse": "catalog:",
    "tsx": "catalog:"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@12.10.1"
}
