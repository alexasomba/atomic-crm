{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atomic-crm",
  "main": "./server/worker.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atomic-crm-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle",
      "migrations_pattern": "./drizzle/*/migration.sql",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "atomic-crm-assets" }],
  "ai": { "binding": "AI" },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@example.com"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_EMAIL_QUEUE",
        "queue": "atomic-crm-inbound-email",
      },
    ],
    "consumers": [
      {
        "queue": "atomic-crm-inbound-email",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:5173",
    "EMAIL_FROM": "noreply@example.com",
    "VITE_INBOUND_EMAIL_ADDRESS": "crm@example.com",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
}
