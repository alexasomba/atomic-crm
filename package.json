{
  "name": "atomic-crm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vitest --config vitest.config.ts",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config",
    "dev:all": "concurrently --kill-others -n app,copilot,mcp -c cyan,green,yellow \"npm run dev:demo\" \"npm run dev:server\" \"npm run dev:mcp\"",
    "dev:server": "cd server && npm run dev",
    "dev:mcp": "cd server && npm run dev:mcp",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --config vite.demo.config",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint:apply": "eslint . --fix",
    "lint": "eslint .",
    "prettier:apply": "prettier --config ./.prettierrc.json --write --list-different \"**/*.{js,json,ts,tsx,css,md,html}\"",
    "prettier": "prettier --config ./.prettierrc.json --check \"**/*.{js,json,ts,tsx,css,md,html}\"",
    "registry:build": "npx shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "ghpages:deploy": "node ./scripts/ghpages-deploy.mjs",
    "supabase:remote:init": "node ./scripts/supabase-remote-init.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@copilotkit/react-core": "1.66.2",
    "@copilotkit/react-ui": "1.66.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@nivo/bar": "^0.99.0",
    "@streamparser/json-whatwg": "^0.0.23",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@types/qs": "^6.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diacritic": "^0.0.2",
    "dompurify": "^3.4.13",
    "driver.js": "^1.8.0",
    "faker": "^5.5.3",
    "inflection": "^3.0.2",
    "json-stream-es": "^1.2.1",
    "jsonexport": "^3.2.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "mime": "^4.1.0",
    "ms": "^2.1.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "qs": "^6.15.3",
    "query-string": "^9.4.1",
    "ra-core": "^5.15.0",
    "ra-data-fakerest": "^5.15.0",
    "ra-i18n-polyglot": "^5.15.0",
    "ra-language-english": "^5.15.0",
    "ra-supabase-core": "^3.5.2",
    "ra-supabase-language-english": "^3.5.0",
    "react": "^19.2.8",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.0.0",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.84.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "rollup-plugin-visualizer": "^6.0.11",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.38.0",
    "@eslint/js": "^9.39.5",
    "@inquirer/prompts": "^8.5.2",
    "@storybook/react-vite": "^10.5.6",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/faker": "^6.6.11",
    "@types/jsonexport": "^3.0.5",
    "@types/lodash": "^4.17.25",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/browser-preview": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
