{
  "name": "atomic-crm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vp test --config vitest.config.ts",
    "test:node": "vp test run --config vitest.node.config.ts",
    "test:integration": "vp test --config vitest.integration.config.ts",
    "dev": "vp dev",
    "dev:demo": "vp dev --config vite.demo.config",
    "dev:all": "concurrently --kill-others -n app,copilot,mcp -c cyan,green,yellow \"npm run dev:demo\" \"npm run dev:server\" \"npm run dev:mcp\"",
    "dev:server": "cd server && npm run dev",
    "dev:mcp": "cd server && npm run dev:mcp",
    "build": "tsc && vp build",
    "build:demo": "tsc && vp build --config vite.demo.config",
    "typecheck": "tsc --noEmit",
    "preview": "vp preview",
    "lint:apply": "vp lint **/*.{mjs,ts,tsx} --fix",
    "lint": "vp lint **/*.{mjs,ts,tsx}",
    "prettier:apply": "vp fmt --check \"**/*.{js,json,ts,tsx,css,md,html}\"",
    "prettier": "vp fmt --check \"**/*.{js,json,ts,tsx,css,md,html}\"",
    "registry:build": "npx shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "ghpages:deploy": "node ./scripts/ghpages-deploy.mjs",
    "supabase:remote:init": "node ./scripts/supabase-remote-init.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
