{
  "name": "atomic-crm",
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "test": "vp test run --config vitest.config.ts",
    "test:unit": "vp test run --config vitest.config.ts",
    "test:node": "vp test run --config vitest.node.config.ts",
    "test:integration": "vp test run --config vitest.integration.config.ts",
    "dev": "vp dev",
    "dev:demo": "vp dev --config vite.demo.config",
    "dev:all": "concurrently --kill-others -n app,copilot,mcp -c cyan,green,yellow \"pnpm run dev:demo\" \"pnpm run dev:server\" \"pnpm run dev:mcp\"",
    "dev:server": "pnpm --dir server run dev",
    "dev:mcp": "pnpm --dir server run dev:mcp",
    "build": "tsc && vp build",
    "build:demo": "tsc && vp build --config vite.demo.config",
    "typecheck": "tsc --noEmit",
    "preview": "vp preview",
    "check": "vp check",
    "lint:apply": "vp lint --fix",
    "lint": "vp lint",
    "prettier:apply": "vp fmt --write",
    "prettier": "vp fmt --check",
    "registry:build": "pnpm exec shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "ghpages:deploy": "node ./scripts/ghpages-deploy.mjs",
    "supabase:remote:init": "node ./scripts/supabase-remote-init.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.77.2",
    "@faker-js/faker": "^10.6.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@nivo/bar": "^0.99.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@streamparser/json-whatwg": "^0.0.26",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cropperjs": "^1.7.0",
    "date-fns": "^4.4.0",
    "diacritic": "^0.0.2",
    "dompurify": "^3.4.16",
    "driver.js": "^1.9.0",
    "inflection": "^3.0.2",
    "jsonexport": "^3.2.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.0",
    "mime": "^4.1.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "query-string": "^7.1.3",
    "ra-core": "^5.15.4",
    "ra-data-fakerest": "^5.15.4",
    "ra-i18n-polyglot": "^5.15.4",
    "ra-language-english": "^5.15.4",
    "ra-supabase-core": "^3.5.2",
    "ra-supabase-language-english": "^3.5.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.44.0",
    "@inquirer/prompts": "^8.7.3",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsonexport": "^3.0.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "concurrently": "^10.0.6",
    "eslint-plugin-storybook": "^10.6.1",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "shadcn": "^4.21.4",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-simple-html": "^1.1.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0"
  }
}
