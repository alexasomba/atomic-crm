{
  "name": "atomic-crm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:node": "vp test run --config vitest.node.config.ts",
    "test:worker": "vp test run --config vitest.node.config.ts test/cloudflare-worker.test.ts",
    "test:integration": "vp test --config vitest.integration.config.ts",
    "test:tanstack": "VITE_ROUTER=tanstack vp test --run",
    "test:integration:tanstack": "VITE_ROUTER=tanstack vp test --config vitest.integration.config.ts --run",
    "dev:demo": "vp dev --config vite.demo.config.ts",
    "dev:all": "concurrently --kill-others -n app,worker,mcp -c cyan,green,yellow \"vp dev\" \"wrangler dev --config wrangler.jsonc\" \"cd server && PORT= MCP_PORT=${MCP_PORT:-3108} npm run dev:mcp\"",
    "smoke:staging": "node ./scripts/cloudflare-staging-smoke.mjs",
    "smoke:staging:browser": "node ./scripts/cloudflare-staging-browser-smoke.mjs",
    "sso:register:staging": "node ./scripts/cloudflare-staging-sso.mjs",
    "dev:server": "cd server && npm run dev",
    "dev:mcp": "cd server && npm run dev:mcp",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "dev:staging": "wrangler dev --config wrangler.staging.jsonc",
    "dev:cloudflare": "concurrently --kill-others -n app,worker -c cyan,green \"vp dev\" \"wrangler dev --config wrangler.jsonc\"",
    "worker:types": "wrangler types --config wrangler.jsonc server/worker-env.d.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:up": "drizzle-kit up --config drizzle.config.ts",
    "auth:generate": "pnpm dlx auth@beta generate --config ./server/auth.ts --output ./server/db/auth-schema.ts --yes",
    "data:seed:staging": "node ./scripts/cloudflare-staging-seed.mjs",
    "data:seed:staging:reset": "node ./scripts/cloudflare-staging-seed.mjs --reset",
    "auth:bootstrap:staging": "node ./scripts/cloudflare-staging-auth.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply atomic-crm-db --local --config wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply atomic-crm-db --remote --config wrangler.jsonc",
    "d1:migrate:staging": "wrangler d1 migrations apply atomic-crm-staging-db --remote --config wrangler.staging.jsonc",
    "build:staging": "VITE_ROUTER=tanstack vp build",
    "deploy:staging": "pnpm run build:staging && wrangler deploy --config wrangler.staging.jsonc",
    "build:demo": "vp build --config vite.demo.config.ts",
    "registry:build": "vp exec shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "ghpages:deploy": "node ./scripts/ghpages-deploy.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "typecheck:worker": "tsc6 -p server/tsconfig.check.json --noEmit"
  },
