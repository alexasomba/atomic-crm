    "eslint-plugin-storybook": "^9.1.20",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.1",
    "storybook": "^10.5.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-simple-html": "^1.1.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}